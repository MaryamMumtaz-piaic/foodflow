# OpenAI API key. Leave blank to run FoodFlow fully in rule-based fallback mode
# (all AI agents will use deterministic heuristics instead of calling OpenAI).
OPENAI_API_KEY=

# OpenAI-compatible chat model used by the AI agents.
OPENAI_MODEL=gpt-4.1-mini

# Application environment: development | production | testing
APP_ENV=development

# Secret key used to sign/obfuscate mock auth tokens. Change this in production.
SECRET_KEY=change-me
